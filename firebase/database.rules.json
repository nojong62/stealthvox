{
  "rules": {
    "duo_board_waiting": {
      "$requestId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || (newData.hasChildren(['online', 'updatedAt']) && newData.child('online').val() == true)"
        }
      }
    }
  }
}
