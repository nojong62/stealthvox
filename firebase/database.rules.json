{
  "rules": {
    "duo_board_waiting": {
      "$requestId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || newData.hasChildren(['online', 'updatedAt'])",
          "online": {
            ".validate": "newData.val() == true"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "duo_board_hosts": {
      "$uid": {
        "$connectionId": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.val() == null || newData.hasChildren(['foreground', 'lastSeen'])",
          "foreground": {
            ".validate": "newData.val() == true"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
