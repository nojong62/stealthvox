rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // User profile and user-owned subcollections.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny([
          'remainingTime',
          'remaining_seconds',
          'parentConsentGrantedAt',
          'parentConsentMethod',
          'parentConsentEmail'
        ])
        && (
          !request.resource.data.keys().hasAny(['parentConsentPending'])
          || request.resource.data.parentConsentPending == true
        );

      // remainingTime, remaining_seconds, and consent approval fields are server-owned.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'remainingTime',
            'remaining_seconds',
            'parentConsentGrantedAt',
            'parentConsentMethod',
            'parentConsentEmail'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['parentConsentPending'])
          || request.resource.data.parentConsentPending == true
        );
      allow delete: if false;

      match /chat_history/{docId} {
        allow read, write: if isOwner(uid);

        match /messages/{msgId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /keepers/{keeperId} {
        allow read, write: if isOwner(uid);
      }

      match /clones/{cloneId} {
        allow read, write: if isOwner(uid);
      }

      match /usage_logs/{logId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Duo shared sessions. Anonymous users pass this after signInAnonymously().
    //
    // READ stays open to any signed-in user, on purpose: an invited guest must
    // read the room (mode, isDuoEnabled, hostLang) BEFORE they are recorded as
    // a participant, and a member who signs in after an anonymous Duo call
    // restores that call under a uid the room has never seen. Both flows break
    // the moment reads require participation. Knowing a room id therefore
    // grants read access -- room ids are random Firestore ids shared only over
    // the invite link.
    //
    // WRITES are participant-only. This is the part that can be tightened
    // without breaking either flow above.
    match /duo_sessions/{roomId} {
      function isParticipant() {
        // get(key, default) 로 읽는다. 아직 게스트가 없는 방에서 partnerUid를
        // 그냥 읽으면 "필드 없음"이 평가 오류가 되어, 규칙이 아니라 오류로
        // 거부된다 -- 결과는 같아도 왜 막혔는지 알 수 없게 된다.
        return isAuth()
          && (resource.data.get('hostUid', '') == request.auth.uid
              || resource.data.get('partnerUid', '') == request.auth.uid);
      }

      // 🔒 참가자라도 **주인 자리는 못 바꾼다.**
      //
      // 이게 없으면 게스트가 hostUid를 자기 uid로 덮어써서 방을 통째로 가져
      // 간다. 그 순간 진짜 호스트는 자기 방의 참가자가 아니게 되어 발화도
      // flush도 canonical도 못 쓰고, 방을 지울 권한까지 넘어간다.
      // (에뮬레이터 검증에서 실제로 재현됐다 -- 2026-08-29)
      //
      // 게스트가 처음 자리를 잡는 경로는 아래 isTakingFreeSeat()이 따로 연다.
      function ownersUnchanged() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['hostUid', 'partnerUid']);
      }

      // A guest taking a free seat. The seat is free when nobody is currently
      // joined; the host may re-invite someone else after the first guest
      // leaves, so this cannot require partnerUid to be absent. The host slot
      // itself must not change.
      function isTakingFreeSeat() {
        return isAuth()
          && resource.data.get('isPartnerJoined', false) != true
          && request.resource.data.partnerUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid;
      }

      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if (isParticipant() && ownersUnchanged())
        || isTakingFreeSeat();
      allow delete: if isAuth()
        && resource.data.get('hostUid', '') == request.auth.uid;

      // Each phone's own transcript of the call. Both sides read the whole
      // channel; only the two participants may add to it.
      match /messages/{msgId} {
        allow read: if isAuth();
        allow write: if isAuth()
          && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('hostUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('partnerUid', '') == request.auth.uid);
      }

      // One shared, tidied conversation per call. Both phones read it to
      // rebuild their own study room, and a guest who signs in to an existing
      // account afterwards restores that call from here -- so read must stay
      // open for the same reason as the session document. Only participants
      // may build it. Rules do not cascade into subcollections, so this block
      // is required on its own.
      match /canonical/{docId} {
        allow read: if isAuth();
        allow write: if isAuth()
          && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('hostUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('partnerUid', '') == request.auth.uid);
      }
    }

    // One-device trial guard. Anonymous users are allowed after signInAnonymously().
    match /trial_devices/{fid} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }
    // Welcome bonus device guard. Only Cloud Functions Admin SDK should access it.
    match /welcome_devices/{deviceId} {
      allow read, write: if false;
    }

    // Kakao account to Firebase uid map. Admin SDK only.
    match /kakao_uid_map/{kakaoId} {
      allow read, write: if false;
    }
  }
}
