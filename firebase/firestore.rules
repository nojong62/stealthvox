rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Operator-only membership ledger. Cloud Functions writes it with the
    // Admin SDK; no app client may enumerate members or alter purchase totals.
    match /real_members/{uid} {
      allow read, write: if false;

      match /purchases/{purchaseId} {
        allow read, write: if false;
      }
    }

    // Duo 게시판은 인증된 익명 Guest도 읽을 수 있다. 작성과 선점은 서버
    // callable만 수행하며, 초대 roomId가 있는 runtime은 클라이언트에 숨긴다.
    match /duo_board_posts/{postId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /duo_board_runtime/{postId} {
      allow read, write: if false;
    }

    match /duo_board_requests/{requestId} {
      allow read: if isAuth() &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.requesterUid == request.auth.uid);
      allow write: if false;
    }

    // User profile and user-owned subcollections.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny([
          'remainingTime',
          'remaining_seconds',
          'parentConsentGrantedAt',
          'parentConsentMethod',
          'parentConsentEmail'
        ])
        && (
          !request.resource.data.keys().hasAny(['parentConsentPending'])
          || request.resource.data.parentConsentPending == true
        );

      // remainingTime, remaining_seconds, and consent approval fields are server-owned.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'remainingTime',
            'remaining_seconds',
            'parentConsentGrantedAt',
            'parentConsentMethod',
            'parentConsentEmail'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['parentConsentPending'])
          || request.resource.data.parentConsentPending == true
        );
      allow delete: if false;

      match /chat_history/{docId} {
        allow read, write: if isOwner(uid);

        match /messages/{msgId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /keepers/{keeperId} {
        allow read, write: if isOwner(uid);
      }

      match /clones/{cloneId} {
        allow read, write: if isOwner(uid);
      }

      match /usage_logs/{logId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /fcm_tokens/{installationId} {
        allow read: if false;
        allow create, update, delete: if isOwner(uid);
      }
    }

    // Duo shared sessions. Anonymous users pass this after signInAnonymously().
    //
    // READ stays open to any signed-in user, on purpose: an invited guest must
    // read the room (mode, isDuoEnabled, hostLang) BEFORE they are recorded as
    // a participant, and a member who signs in after an anonymous Duo call
    // restores that call under a uid the room has never seen. Both flows break
    // the moment reads require participation. Knowing a room id therefore
    // grants read access -- room ids are random Firestore ids shared only over
    // the invite link.
    //
    // WRITES are participant-only. This is the part that can be tightened
    // without breaking either flow above.
    match /duo_sessions/{roomId} {
      function isParticipant() {
        // get(key, default) 로 읽는다. 아직 게스트가 없는 방에서 partnerUid를
        // 그냥 읽으면 "필드 없음"이 평가 오류가 되어, 규칙이 아니라 오류로
        // 거부된다 -- 결과는 같아도 왜 막혔는지 알 수 없게 된다.
        return isAuth()
          && (resource.data.get('hostUid', '') == request.auth.uid
              || resource.data.get('partnerUid', '') == request.auth.uid);
      }

      // 🔒 참가자라도 **주인 자리는 못 바꾼다.**
      //
      // 이게 없으면 게스트가 hostUid를 자기 uid로 덮어써서 방을 통째로 가져
      // 간다. 그 순간 진짜 호스트는 자기 방의 참가자가 아니게 되어 발화도
      // flush도 canonical도 못 쓰고, 방을 지울 권한까지 넘어간다.
      // (에뮬레이터 검증에서 실제로 재현됐다 -- 2026-08-29)
      //
      // 게스트가 처음 자리를 잡는 경로는 아래 isTakingFreeSeat()이 따로 연다.
      function ownersUnchanged() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['hostUid', 'partnerUid']);
      }

      // A guest taking a free seat. The seat is free when nobody is currently
      // joined; the host may re-invite someone else after the first guest
      // leaves, so this cannot require partnerUid to be absent. The host slot
      // itself must not change.
      function isTakingFreeSeat() {
        return isAuth()
          && resource.data.get('isPartnerJoined', false) != true
          && request.resource.data.partnerUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid;
      }

      function interpreterNegotiationCreateValid() {
        return !request.resource.data.keys().hasAny([
            'partnerInterpreterCallablePcV2',
            'partnerSameOriginDirectV1',
            'interpreterProtocol',
            'interpreterProtocolLockedAt',
            'resolvedMode',
            'resolvedModeLockedAt',
            'resolutionReason'
          ])
          && (!request.resource.data.keys().hasAny([
                'hostInterpreterCallablePcV2'
              ])
              || (request.resource.data.get('mode', '') == 'interpreter'
                  && request.resource.data.hostInterpreterCallablePcV2
                      is bool))
          && (!request.resource.data.keys().hasAny([
                'hostSameOriginDirectV1'
              ])
              || (request.resource.data.get('mode', '') == 'interpreter'
                  && request.resource.data.hostSameOriginDirectV1 is bool));
      }

      function isResolvableDuoOrigin(value) {
        return value in [
          'English', 'Japanese', 'Chinese', 'Spanish', 'French', 'German',
          'Korean', 'Hindi', 'Russian', 'Portuguese', 'Italian', 'Dutch'
        ];
      }

      function interpreterNegotiationUpdateValid() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let protocolWrite = changed.hasAny([
          'interpreterProtocol',
          'interpreterProtocolLockedAt'
        ]);
        let resolutionWrite = changed.hasAny([
          'resolvedMode',
          'resolvedModeLockedAt',
          'resolutionReason'
        ]);
        return !changed.hasAny([
            'hostInterpreterCallablePcV2',
            'hostSameOriginDirectV1'
          ])
          && (!changed.hasAny(['partnerInterpreterCallablePcV2'])
              || (isTakingFreeSeat()
                  && request.resource.data.partnerInterpreterCallablePcV2
                      is bool))
          && (!changed.hasAny(['partnerSameOriginDirectV1'])
              || (isTakingFreeSeat()
                  && request.resource.data.partnerSameOriginDirectV1 is bool))
          && (!resolutionWrite
              || (request.auth.uid == resource.data.get('hostUid', '')
                  && resource.data.get('mode', '') == 'interpreter'
                  && resource.data.get('isPartnerJoined', false) == true
                  && !resource.data.keys().hasAny([
                    'resolvedMode',
                    'resolvedModeLockedAt',
                    'resolutionReason'
                  ])
                  && request.resource.data.resolvedMode in [
                    'direct', 'interpreter'
                  ]
                  && request.resource.data.resolvedModeLockedAt is timestamp
                  && request.resource.data.resolutionReason in [
                    'same_origin',
                    'translation_required',
                    'compatibility_fallback',
                    'language_unavailable'
                  ]
                  && ((request.resource.data.resolvedMode == 'direct'
                        && request.resource.data.resolutionReason ==
                          'same_origin'
                        && resource.data.get(
                            'hostSameOriginDirectV1', false) == true
                        && resource.data.get(
                            'partnerSameOriginDirectV1', false) == true
                        && isResolvableDuoOrigin(
                            resource.data.get('hostLang', ''))
                        && resource.data.get('hostLang', '') ==
                          resource.data.get('partnerLang', '')
                        && !protocolWrite
                        && !resource.data.keys().hasAny([
                          'interpreterProtocol',
                          'interpreterProtocolLockedAt'
                        ]))
                      || (request.resource.data.resolvedMode == 'interpreter'
                        && request.resource.data.resolutionReason !=
                          'same_origin'
                        && (resource.data.get('interpreterProtocol', '') in [
                              'legacy_webrtc_v1', 'callable_pc_v2'
                            ]
                            || protocolWrite)))))
          && (!protocolWrite
              || (request.auth.uid ==
                    resource.data.get('hostUid', '')
                  && resource.data.get('mode', '') == 'interpreter'
                  && resource.data.get('isPartnerJoined', false) == true
                  && !resource.data.keys().hasAny([
                    'interpreterProtocol',
                    'interpreterProtocolLockedAt'
                  ])
                  && request.resource.data.interpreterProtocol in [
                    'legacy_webrtc_v1',
                    'callable_pc_v2'
                  ]
                  && request.resource.data.interpreterProtocolLockedAt
                      is timestamp
                  && request.resource.data.get(
                      'resolvedMode', 'interpreter') == 'interpreter'
                  && (request.resource.data.interpreterProtocol ==
                        'legacy_webrtc_v1'
                      || (resource.data.get(
                              'hostInterpreterCallablePcV2', false) == true
                          && resource.data.get(
                              'partnerInterpreterCallablePcV2', false) ==
                            true))));
      }

      // Invite and post-login handoff both know one random room id and need a
      // direct document lookup before the caller is recorded as a participant.
      // That does not require collection enumeration. Keeping `read` here
      // would also grant `list`, allowing any signed-in account to discover
      // every live/finished Duo room and the participant UIDs stored in it.
      allow get: if isAuth();
      allow list: if false;
      allow create: if isAuth()
        && request.resource.data.hostUid == request.auth.uid
        && interpreterNegotiationCreateValid();
      allow update: if ((isParticipant() && ownersUnchanged())
          || isTakingFreeSeat())
        && interpreterNegotiationUpdateValid();
      allow delete: if isAuth()
        && resource.data.get('hostUid', '') == request.auth.uid;

      // Each phone's own transcript of the call. Both sides read the whole
      // channel; only the two participants may add to it.
      match /messages/{msgId} {
        allow read: if isAuth();
        allow write: if isAuth()
          && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('hostUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('partnerUid', '') == request.auth.uid);
      }

      // Callable Interpreter utterances are server-owned. Participants may
      // restore live UI state, but no client may forge seq, direction, status,
      // translation, or processing leases.
      match /utterances/{utteranceId} {
        allow read: if isAuth()
          && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('hostUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('partnerUid', '') == request.auth.uid);
        allow create, update, delete: if false;
      }

      // One shared, tidied conversation per call. Both phones read it to
      // rebuild their own study room, and a guest who signs in to an existing
      // account afterwards restores that call from here -- so read must stay
      // open for the same reason as the session document. Only participants
      // may build it. Rules do not cascade into subcollections, so this block
      // is required on its own.
      match /canonical/{docId} {
        allow read: if isAuth();
        allow write: if isAuth()
          && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('hostUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('partnerUid', '') == request.auth.uid);
      }

      // The study-facing reconstruction of the same call. It lives beside
      // canonical, never inside it: canonical keeps every line the two people
      // actually spoke, and this layer is allowed to leave lines out. Both
      // phones read it, only participants build it -- exactly the canonical
      // rule, because it carries the same call and the same participants.
      // Rules do not cascade into subcollections, so this block is required
      // on its own.
      match /replay/{docId} {
        allow read: if isAuth();
        allow write: if isAuth()
          && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('hostUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('partnerUid', '') == request.auth.uid);
      }

      // WebRTC signalling for the direct-talk call: offer/answer SDP and ICE
      // candidates. This carries no conversation content -- only the network
      // handshake that lets the two phones connect their audio directly.
      //
      // Unlike messages/canonical/replay, read is NOT open to any signed-in
      // user: a third party who reads the offer could try to answer it and
      // join the call's audio. Both read and write are restricted to the two
      // participants. Rules do not cascade into subcollections, so the
      // candidates collection below needs its own identical block.
      match /webrtc/{docId} {
        allow read, write: if isAuth()
          && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('hostUid', '') == request.auth.uid
              || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                .data.get('partnerUid', '') == request.auth.uid);

        match /candidates/{candidateId} {
          allow read, write: if isAuth()
            && (get(/databases/$(database)/documents/duo_sessions/$(roomId))
                  .data.get('hostUid', '') == request.auth.uid
                || get(/databases/$(database)/documents/duo_sessions/$(roomId))
                  .data.get('partnerUid', '') == request.auth.uid);
        }
      }
    }

    // AI trial grants and their one-device guard are owned by Cloud Functions.
    // Client writes would let an attacker mint or replace their own entitlement.
    match /trial_devices/{fid} {
      allow read, write: if false;
    }
    match /ai_trial_grants/{uid} {
      allow read, write: if false;
    }
    // Welcome bonus device guard. Only Cloud Functions Admin SDK should access it.
    match /welcome_devices/{deviceId} {
      allow read, write: if false;
    }

    // Kakao account to Firebase uid map. Admin SDK only.
    match /kakao_uid_map/{kakaoId} {
      allow read, write: if false;
    }
  }
}
