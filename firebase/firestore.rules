rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // User profile and user-owned subcollections.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny([
          'remainingTime',
          'remaining_seconds',
          'parentConsentGrantedAt',
          'parentConsentMethod',
          'parentConsentEmail'
        ])
        && (
          !request.resource.data.keys().hasAny(['parentConsentPending'])
          || request.resource.data.parentConsentPending == true
        );

      // remainingTime, remaining_seconds, and consent approval fields are server-owned.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'remainingTime',
            'remaining_seconds',
            'parentConsentGrantedAt',
            'parentConsentMethod',
            'parentConsentEmail'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['parentConsentPending'])
          || request.resource.data.parentConsentPending == true
        );
      allow delete: if false;

      match /chat_history/{docId} {
        allow read, write: if isOwner(uid);

        match /messages/{msgId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /keepers/{keeperId} {
        allow read, write: if isOwner(uid);
      }

      match /clones/{cloneId} {
        allow read, write: if isOwner(uid);
      }

      match /usage_logs/{logId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Duo shared sessions. Anonymous users pass this after signInAnonymously().
    match /duo_sessions/{roomId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth()
        && resource.data.hostUid == request.auth.uid;

      match /messages/{msgId} {
        allow read, write: if isAuth();
      }
    }

    // One-device trial guard. Anonymous users are allowed after signInAnonymously().
    match /trial_devices/{fid} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }
    // Welcome bonus device guard. Only Cloud Functions Admin SDK should access it.
    match /welcome_devices/{deviceId} {
      allow read, write: if false;
    }

    // Kakao account to Firebase uid map. Admin SDK only.
    match /kakao_uid_map/{kakaoId} {
      allow read, write: if false;
    }
  }
}
